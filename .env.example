# ==========================================
# BhoomiSetu - Environment Configuration
# ==========================================

# Port for backend Express server
PORT=3001

# ==========================================
# 1. CORE STATUTORY DATABASE & STORAGE
# ==========================================
# Supabase PostgreSQL Database & Storage Engine
# Used by both Backend (with service role / anon key) and Frontend (Anon key only)
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Client-facing Supabase variables (Vite exposed - ONLY Anon key, NEVER Service Role)
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ==========================================
# 2. DOCUMENT INTELLIGENCE & MULTIMODAL AI
# ==========================================
# Google Gemini API Key (STRICTLY SERVER-SIDE ONLY - NEVER PREFIX WITH VITE_)
# Free tier: 15 Requests Per Minute (RPM), 1M Tokens Per Minute (TPM), 1,500 Requests Per Day (RPD).
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# ==========================================
# 3. OPTIONAL ENTERPRISE GEOSPATIAL & ROUTING
# ==========================================
# Google Maps Platform API Key (SERVER-SIDE ONLY)
# Used for: Google Compute Routes (traffic-aware road routing), high-accuracy address geocoding, and hybrid satellite tiles.
# Pricing: Pay-as-you-go per SKU. Free monthly tier includes 10,000 free events/month per SKU on Essentials.
# Prototyping: Can use Google Maps Demo Key for testing.
# If omitted: BhoomiSetu automatically falls back to OpenStreetMap OSRM (routing) and Nominatim (geocoding).
GOOGLE_MAPS_API_KEY=

# MapTiler Cloud API Key (Optional High-Resolution Basemaps & Topo/Satellite Cartography)
# Used for: Vector & raster map styles, Streets v2, Topo v2 terrain, and Satellite imagery.
# Free Tier: 100,000 map tile requests/month under non-commercial fair use.
# Register at: https://www.maptiler.com/cloud/
MAPTILER_API_KEY=
VITE_MAPTILER_API_KEY=

# ==========================================
# 4. OPTIONAL SATELLITE EARTH OBSERVATION
# ==========================================
# Copernicus Data Space Ecosystem (CDSE) OAuth Credentials
# Used for: ESA Sentinel-2 L2A optical imagery STAC catalog search and multispectral granule metadata.
# Free tier: 10,000 Processing Units (PU)/month and 2,000 requests/minute.
# Register at: https://dataspace.copernicus.eu/
# If omitted: STAC search operates in open/public unauthenticated catalog mode; sovereign thematic map layers remain active via ISRO Bhuvan OGC WMS (zero credentials needed).
COPERNICUS_CDSE_CLIENT_ID=
COPERNICUS_CDSE_CLIENT_SECRET=

# ==========================================
# 5. OPTIONAL NATIONAL MULTILINGUAL TRANSLATION
# ==========================================
# Bhashini / ULCA Credentials (MeitY, Government of India)
# Used for: Official statutory translation of land acquisition notices across 22 scheduled Indian languages.
# Register at: https://bhashini.gov.in/ulca
# If omitted: Translation falls back to Google Gemini Flash (if GEMINI_API_KEY is present) or offline passthrough (never claiming uncredentialed text is translated).
BHASHINI_API_KEY=
BHASHINI_USER_ID=

# ==========================================
# 6. OPEN / ZERO-CREDENTIAL PROVIDERS (BUILT-IN)
# ==========================================
# The following services are configured by default and require zero API credentials:
# - OpenStreetMap Nominatim: Geocoding (subject to 1 req/sec Nominatim Usage Policy)
# - OpenStreetMap OSRM: Road routing (topological graph, public community service subject to fair use)
# - ISRO Bhuvan: Sovereign OGC WMS thematic layers (LULC 50K, Wasteland 50K, Flood Hazard)
# - Open-Meteo: Meteorological observations (CC-BY 4.0, up to 10,000 calls/day non-commercial)

# ==========================================
# 7. OPEN GOVERNMENT DATA (DATA.GOV.IN / LGD)
# ==========================================
# Open Government Data (OGD) Platform India API Key (SERVER-SIDE ONLY - NEVER PREFIX WITH VITE_)
# Used for: Authoritative Local Government Directory (LGD) administrative hierarchy (States, Districts, Sub-Districts, Villages)
# Register at: https://data.gov.in (Generate API key under My Account -> API Access)
LGD_DATA_GOV_API_KEY=

# Canonical OGD India LGD Catalog Resource IDs (Server-Side Configuration)
LGD_STATES_RESOURCE_ID=a71e60f0-a21d-43de-a6c5-fa5d21600cdb
LGD_DISTRICTS_RESOURCE_ID=37231365-78ba-44d5-ac22-3deec40b9197
LGD_SUBDISTRICTS_RESOURCE_ID=6be51a29-876a-403a-a6da-42fde795e751
LGD_VILLAGES_RESOURCE_ID=c967fe8f-69c4-42df-8afc-8a2c98057437
